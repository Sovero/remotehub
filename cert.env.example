# Скопируйте этот файл в cert.env и заполните реальными значениями.
# cert.env добавлен в .gitignore — никогда не коммитьте приватный ключ.

# Путь к PFX/P12-сертификату (абсолютный или относительно корня проекта).
# Windows-эквивалент: WIN_CSC_LINK
CSC_LINK=./certs/remote-hub.pfx

# Пароль сертификата.
# Windows-эквивалент: WIN_CSC_KEY_PASSWORD
CSC_KEY_PASSWORD=change-me
