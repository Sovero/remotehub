{
  "name": "remote-hub",
  "version": "0.1.19",
  "description": "Remote Hub — Termius-подобное приложение для Windows: SSH, Telnet, RDP, VNC, SFTP",
  "repository": "https://github.com/Sovero/remotehub.git",
  "main": "./out/main/index.js",
  "author": "Remote Hub",
  "license": "MIT",
  "private": true,
  "scripts": {
    "predev": "node scripts/generate-icon.mjs",
    "dev": "electron-vite dev",
    "prebuild": "node scripts/generate-icon.mjs",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e:rdp": "vitest run tests/rdp-iron-e2e.test.ts",
    "help:shots": "node scripts/capture-help.mjs",
    "smoke:rdp:iron": "node scripts/smoke-rdp-iron.mjs",
    "dist": "node scripts/bump-version.mjs && electron-builder install-app-deps && npm run build && electron-builder --win --x64 && node scripts/upload-latest-yml.mjs",
    "dist:sign": "node scripts/bump-version.mjs && electron-builder install-app-deps && npm run build && node scripts/sign.mjs"
  },
  "build": {
    "appId": "com.remotehub.app",
    "productName": "Remote Hub",
    "electronVersion": "43.4.0",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "build/icon.ico",
      "package.json",
      "CHANGELOG.md"
    ],
    "asarUnpack": [
      "node_modules/nanoid/**",
      "node_modules/bufferutil/**",
      "node_modules/utf-8-validate/**",
      "node_modules/cpu-features/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Sovero",
        "repo": "remotehub"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "verifyUpdateCodeSignature": false,
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com",
        "publisherName": "Remote Hub"
      }
    },
    "defaultArch": "x64",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "menuCategory": "Remote Hub",
      "shortcutName": "Remote Hub"
    }
  },
  "dependencies": {
    "@devolutions/iron-remote-desktop": "^0.11.0",
    "@devolutions/iron-remote-desktop-rdp": "^0.7.0",
    "@novnc/novnc": "^1.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "bufferutil": "^4.1.0",
    "electron-updater": "^6.8.9",
    "nanoid": "^6.0.1",
    "node-rdpjs": "^0.3.0",
    "node-rdpjs-2": "^0.3.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ssh2": "^1.17.0",
    "telnet-client": "^2.2.14",
    "utf-8-validate": "^6.0.6",
    "ws": "^8.21.3",
    "xterm": "^5.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "bufferutil@4.1.0": true,
    "utf-8-validate@6.0.6": true
  }
}
